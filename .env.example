# 本地 SQLite（默认：项目目录下 data/pmwa.db）
DATABASE_PATH=data/pmwa.db
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=请设置一个至少8位的管理员密码

# 登录会话签名密钥（请生成一段足够长的随机字符串）
AUTH_SECRET=

# QQ 邮箱 SMTP（使用授权码，不是 QQ 登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=1569079479@qq.com
SMTP_PASSWORD=请填写QQ邮箱SMTP授权码
SMTP_FROM=1569079479@qq.com

# 运行保护
SENTRY_DSN=
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# LLM Configuration（用户设置自己的 Key 后会覆盖这些默认值）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# 其他常见提供商（取消注释并填入你的 API Key）：
# OpenRouter:  https://openrouter.ai/api/v1
# Together AI: https://api.together.xyz/v1
# DeepSeek:    https://api.deepseek.com/v1
# Ollama 本地:  http://localhost:11434/v1
